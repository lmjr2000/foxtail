# Copy to .env for local development (never commit .env). Production sets these on the server.

# Postgres. Leave unset locally: `npm run dev` starts an embedded Postgres in .data/pg.
# DATABASE_URL=postgres://user:password@host:5432/foxtail

# Required in production: 32+ random characters. Signs sessions; also seals recorder passwords
# unless RECORDER_SECRET_KEY is set. Changing it signs everyone out and makes saved recorder
# passwords unreadable (re-enter them).
# JWT_SECRET=
# RECORDER_SECRET_KEY=

# Person detection (Roboflow). Every detection is a paid API call. Counting does not run without these.
# ROBOFLOW_API_KEY=
# PERSON_MODEL_ID=            # a hosted model with a "person" class, e.g. <project>/<version>
# PERSON_CLASSES=person
# PERSON_MIN_CONFIDENCE=0.35
# MAX_DETECTIONS_PER_HOUR=3000

# Optional Google sign-in (off when unset). Only signs in logins that already exist.
# GOOGLE_CLIENT_ID=

# PORT=3001
# SESSION_HOURS=12
# SAMPLE_RETENTION_DAYS=180
# SAMPLER_ENABLED=true
# TRUST_PROXY=loopback        # set to the number of proxies in front of the app in production

# Demo site only (its own database!): example stores + one-click look-only logins.
# DEMO_MODE=true
