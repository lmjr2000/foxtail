# Copy to .env for local development (never commit .env).

# Omni Foxtail API base URL. The portal calls this for auth, stores, cameras, insights and alerts.
# In production, configure this in the static host or reverse proxy.
VITE_OMNI_API_BASE_URL=https://omni.example.com/api/v1

# Optional: Google sign-in client ID (Omni enforces this on the server).
# VITE_GOOGLE_CLIENT_ID=
