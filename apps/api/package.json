{
  "name": "@foxtail/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "user:create": "tsx src/tools/create-user.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@foxtail/shared": "*",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "17.10.0-beta.17",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
